<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#bdbdbd"

    android:fillViewport="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_margin="12dp"
        android:outlineAmbientShadowColor="@color/second">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- Titolo -->
            <TextView
                android:id="@+id/titolo_re"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:fontFamily="@font/montserratbold"
                android:textAlignment="center"
                android:textColor="#111111"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Full Body Blast" />

            <!-- Gruppo muscolare -->
            <TextView
                android:id="@+id/tot_ess_txt"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Gruppo Muscolare"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titolo_re"
                tools:text="Gruppo Muscolare" />

            <TextView
                android:id="@+id/ruppo_mus_res_txt"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Petorali"
                app:layout_constraintBaseline_toBaselineOf="@id/tot_ess_txt"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Petorali" />

            <View
                android:id="@+id/view"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/tot_ess_txt"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />

            <!-- Intensità -->
            <TextView
                android:id="@+id/tot_res_txt123"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Intensità"
                app:layout_constraintStart_toStartOf="@id/view"
                app:layout_constraintTop_toBottomOf="@id/view"
                tools:text="Intensità" />

            <TextView
                android:id="@+id/intensita_txt"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media"
                app:layout_constraintBaseline_toBaselineOf="@id/tot_res_txt123"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Media - Allenamento standard" />

            <View
                android:id="@+id/view2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/tot_res_txt123"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />

            <!-- Totale esercizi -->
            <TextView
                android:id="@+id/totale_es_txt"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Totale Esercizi"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view2"
                tools:text="Totale Esercizi" />

            <TextView
                android:id="@+id/totale_es_res_txt"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                app:layout_constraintBaseline_toBaselineOf="@id/totale_es_txt"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="5" />

            <View
                android:id="@+id/view3"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/totale_es_txt"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />

            <!-- Data -->
            <TextView
                android:id="@+id/data_res"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Data"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view3"
                tools:text="Data" />

            <TextView
                android:id="@+id/data_res_txt"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-07-15"
                app:layout_constraintBaseline_toBaselineOf="@id/data_res"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="2025-07-15" />

            <View
                android:id="@+id/view4"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/data_res"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />

            <!-- Promemoria -->
            <TextView
                android:id="@+id/imposta_pre"
                style="@style/style_repielogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Promemoria attivo?"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view4"
                tools:text="Promemoria attivo?" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                app:layout_constraintBaseline_toBaselineOf="@id/imposta_pre"
                app:layout_constraintEnd_toStartOf="@id/check_yes"
                android:layout_marginStart="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_yes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sì"
                app:layout_constraintBaseline_toBaselineOf="@id/imposta_pre"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/view5"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/imposta_pre"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                />

            <!-- Pulsante finale -->
            <include
                android:id="@+id/ly_btn"
                layout="@layout/button_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.core.widget.NestedScrollView>