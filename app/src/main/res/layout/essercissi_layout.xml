<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_essercissi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@color/card_surface"
            android:elevation="4dp">

            <!-- Titolo -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/bs_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratbold"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:text="@string/exercise_add_title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Nome esercizio -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_title"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Name"
                app:boxStrokeColor="@color/accent"
                app:hintTextColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/bs_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_nome"
                    style="@style/testoForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dropdown attrezzo -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lista_attrezzi_layoutx"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Attrezzo"
                app:boxStrokeColor="@color/accent"
                app:hintTextColor="@color/text_secondary"
                app:endIconMode="dropdown_menu"
                app:layout_constraintTop_toBottomOf="@id/layout_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp">

                <AutoCompleteTextView
                    android:id="@+id/lista_attrezzi_txtx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="18sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Serie / Ripetizioni / Iso / Riposo -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_serie"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="# series"
                app:boxStrokeColor="@color/accent"
                app:hintTextColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/lista_attrezzi_layoutx"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/layout_esecuzioni"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_serie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_esecuzioni"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="# reps"
                app:boxStrokeColor="@color/accent"
                app:hintTextColor="@color/text_secondary"
                app:layout_constraintTop_toTopOf="@id/layout_serie"
                app:layout_constraintStart_toEndOf="@id/layout_serie"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_reps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo Peso (opzionale) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_peso"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/exercise_weight_label"
                app:boxStrokeColor="@color/accent"
                app:hintTextColor="@color/text_secondary"
                app:helperText="@string/exercise_weight_hint"
                app:helperTextTextColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/layout_serie"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_peso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_iso"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Iso (s)"
                app:boxStrokeColor="@color/accent"
                app:hintTextColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/layout_peso"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/layout_riposo"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_isometria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_riposo"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Rest (s)"
                app:boxStrokeColor="@color/accent"
                app:hintTextColor="@color/text_secondary"
                app:layout_constraintTop_toTopOf="@id/layout_iso"
                app:layout_constraintStart_toEndOf="@id/layout_iso"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_riposo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bottone Add -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bnt_save"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/exercise_save"
                android:textAllCaps="false"
                android:fontFamily="@font/montserratbold"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/second"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/layout_iso"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
