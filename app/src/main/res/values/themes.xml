<resources>
    <!-- Base application theme. -->
    <style name="Theme.Fityo" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/second</item>
        <item name="colorPrimaryVariant">@color/second</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/second</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.Fityo.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Fityo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Fityo.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />


    <style name="forms">
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingStart">30dp</item>
        <item name="android:paddingEnd">30dp</item>
        <item name="android:background">@color/bg_surface</item>
    </style>

    <style name="testo">
        <item name="android:fontFamily">@font/raleway_medium</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="testoForm">
        <item name="android:fontFamily">@font/raleway_medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="testoForm2">
        <item name="android:fontFamily">@font/raleway_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAlignment">center</item>
    </style>


    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/second</item>
        <item name="android:textColor">@color/black</item>
        <item name="colorPrimary">@color/second</item>
        <item name="buttonBarButtonStyle">@style/MyButtonBarButtonStyle</item>
    </style>


    <style name="MyButtonBarButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/raleway_medium</item>
    </style>

    <style name="style_repielogo" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/raleway_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>

    </style>


    <style name="style_dashboard_titles" parent="Widget.AppCompat.TextView">
    <item name="fontFamily">@font/raleway_bold</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textSize">20sp</item>
    </style>

    <style name="style_dashboard" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/raleway_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">18sp</item>

    </style>



    <style name="CustomDatePicker"  parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:headerBackground">@color/purple_500</item>
        <item name="android:calendarTextColor">@color/purple_700</item>
        <item name="android:dayOfWeekBackground">@android:color/darker_gray</item>
        <item name="android:dayOfWeekTextAppearance">@style/CustomDayOfWeekTextAppearance</item>
        <item name="android:selectedWeekBackgroundColor">@color/purple_500</item>
        <item name="android:datePickerMode">calendar</item>
    </style>

    <style name="CustomDayOfWeekTextAppearance">
        <item name="android:textColor">@color/purple_200</item>
        <item name="android:textSize">14sp</item>
    </style>



    <style name="MaterialCalendarTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <!-- Colore di sfondo del cerchietto -->
        <item name="colorPrimary">@color/second</item>
        <!-- Colore del testo dentro il cerchietto -->
        <item name="colorOnPrimary">@color/white</item>
    </style>



    <style name="ThemeOverlay.Custom.TextInput" parent="ThemeOverlay.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="colorControlActivated">@color/second</item> <!-- Colore bordo in focus -->
        <item name="hintTextColor">@color/second</item>        <!-- Colore hint -->
        <item name="android:textColor">@color/second</item>     <!-- Colore del testo -->
        <item name="boxStrokeColor" >@color/second</item> <!-- Colore del bordo -->


    </style>


    <style name="Hint.RobotoMedium" parent="">
        <item name="android:fontFamily">@font/robotomedium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#555555</item>
    </style>

    <!-- Input text -->
    <style name="Input.RobotoRegular" parent="">
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#111111</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

</resources>
